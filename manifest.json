{
  "manifest_version": "0.3",
  "name": "usda-mcp-server",
  "version": "0.1.7",
  "description": "Search foods, compare nutrients, and look up the full USDA FoodData Central database via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyanheads/usda-mcp-server"
  },
  "homepage": "https://github.com/cyanheads/usda-mcp-server#readme",
  "license": "Apache-2.0",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_AUTH_MODE": "none",
        "NODE_ENV": "production",
        "USDA_FDC_API_KEY": "${USDA_FDC_API_KEY}"
      }
    }
  },
  "compatibility": {
    "runtimes": {
      "node": ">=24.0.0"
    }
  },
  "tools_generated": true,
  "prompts_generated": true,
  "user_config": {
    "USDA_FDC_API_KEY": {
      "title": "USDA FDC API Key",
      "description": "API key for the USDA FoodData Central API. Get one free at https://api.data.gov/signup/",
      "type": "string"
    }
  }
}
